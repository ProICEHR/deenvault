{
  "name": "deenvault-governance-engine",
  "version": "0.1.0",
  "description": "Sovereign AI Governance Infrastructure for African Institutions",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx watch server/index.ts\" \"vite --config vite.config.ts\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts",
    "start": "tsx server/index.ts",
    "seed": "tsx scripts/seed.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "verify": "tsx tests/verify-all.ts",
    "verify:crypto": "tsx tests/verify-crypto.test.ts",
    "verify:replay": "tsx tests/verify-replay.test.ts",
    "verify:session": "tsx tests/verify-session.test.ts",
    "verify:withrls": "tsx tests/verify-withRls.test.ts",
    "verify:agent": "tsx tests/verify-policy-agent.test.ts",
    "test:e2e": "bash scripts/test-policy-agent.sh"
  },
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.36.0",
    "drizzle-zod": "^0.8.3",
    "express": "^4.21.0",
    "express-rate-limit": "^8.3.2",
    "express-session": "^1.18.0",
    "pg": "^8.13.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.1",
    "tsx": "^4.19.0",
    "wouter": "^3.9.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "drizzle-kit": "^0.28.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.0",
    "vite": "^8.0.5"
  }
}
