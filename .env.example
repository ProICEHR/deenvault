# ============================================================
# DeenVault AI Agents — Environment Configuration
# ============================================================
# Copy this to .env and fill in production values.
# NEVER commit .env to version control.
# ============================================================

# ─── Database ─────────────────────────────────────────────
# Must connect as deenvault_app role, NOT superuser.
DATABASE_URL=postgresql://deenvault_app:CHANGE_ME@localhost:5432/deenvault

# ─── Session ──────────────────────────────────────────────
SESSION_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_STRING

# ─── Region Sovereignty ──────────────────────────────────
# These define the deployment's region identity.
# Each deployment instance has unique values.

# NG = Nigeria, EG = Egypt
REGION_ANCHOR=NG

# Unique deployment identifier
REGION_ID=NG-LAGOS-01

# Per-region HMAC signing key (unique per region, never shared)
HMAC_REGION_KEY=CHANGE_ME_TO_RANDOM_64_CHAR_HEX

# Key version for rotation tracking
HMAC_KEY_VERSION=v1

# Policy version for agent execution
POLICY_VERSION=v1.0

# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── CORS ────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In development, localhost origins are allowed automatically.
ALLOWED_ORIGINS=https://your-frontend-domain.com
